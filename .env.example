# Copy to .env and adjust.

# PostgreSQL. DATABASE_URL is used by the app, DIRECT_URL by migrations.
# Local / Neon: both can be the same string.
# Supabase: DATABASE_URL = "Transaction pooler" URI (port 6543) + "?pgbouncer=true&connection_limit=1"
#           DIRECT_URL   = "Session pooler" URI (port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: Vercel Blob token for product image uploads in production.
# When unset, images are stored under public/uploads (local development only).
BLOB_READ_WRITE_TOKEN=""

# Initial admin credentials used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@simetria.lt"
SEED_ADMIN_PASSWORD="Simetria-2026!"

# Temporary photo used in every image slot until real imagery is added.
# Leave unset for the default Unsplash placeholder; set to "" to use files from public/images.
# NEXT_PUBLIC_PLACEHOLDER_IMAGE=""
# Temporary product photo for catalogue items without images (same rules as above).
# NEXT_PUBLIC_PRODUCT_PLACEHOLDER_IMAGE=""

# Optional: AI for the catalogue import (structures PDF text into product fields, picks matching
# photos from web search results). Create a key at https://platform.claude.com
# ANTHROPIC_API_KEY=""

# Optional: web image search for product photos in the catalogue import (one provider is enough):
# - Serper.dev (recommended): Google Images for the whole web, 2,500 free searches, then ~$1 / 1,000.
#   Key from https://serper.dev
# SERPER_API_KEY=""
# - Brave Search API image search: https://api-dashboard.search.brave.com
# BRAVE_SEARCH_API_KEY=""
# - Google Programmable Search (new engines can only search the sites listed in them):
#   engine ID from https://programmablesearchengine.google.com, API key from Google Cloud (Custom Search API)
# GOOGLE_CSE_KEY=""
# GOOGLE_CSE_CX=""

# VAT added on top of supplier price-list prices in the import wizard (default 21)
# IMPORT_VAT_PERCENT=21
