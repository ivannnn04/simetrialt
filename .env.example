# Copy to .env and adjust.

# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / local).
# Local example: postgresql://postgres:postgres@localhost:5432/simetria
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: Vercel Blob token for product image uploads in production.
# When unset, images are stored under public/uploads (local development only).
BLOB_READ_WRITE_TOKEN=""

# Initial admin credentials used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@simetria.lt"
SEED_ADMIN_PASSWORD="admin123"
