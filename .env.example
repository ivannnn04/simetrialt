# Copy to .env and adjust.
# SQLite for local dev; switch provider to postgresql in prisma/schema.prisma for production.
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Initial admin credentials used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@simetria.lt"
SEED_ADMIN_PASSWORD="admin123"
